+	{
+		glReadPixels(0, 0, sw, sh, GL_RGBA, GL_UNSIGNED_BYTE, SecondScreenPixels.data());
+		pic = SecondScreenPixels.data();
+		if (SecondScreenLast.size() == picBytes && memcmp(SecondScreenLast.data(), pic, picBytes) == 0) { if (SecondScreenStill < 1000) SecondScreenStill++; }
+		else { SecondScreenStill = 0; SecondScreenLast.assign(pic, pic + picBytes); banana_bottom_present(pic, sw, sh); }
+	}
+	{
+		struct timespec t1; clock_gettime(CLOCK_MONOTONIC, &t1);
+		sumUs += (uint64_t)((t1.tv_sec - t0.tv_sec) * 1000000LL + (t1.tv_nsec - t0.tv_nsec) / 1000);
+		sumDrawUs += (uint64_t)((tD.tv_sec - t0.tv_sec) * 1000000LL + (tD.tv_nsec - t0.tv_nsec) / 1000);
+		if (++frames % 100 == 0 && getenv("BANANA_BOTTOM_DEBUG"))
+		{
+			fprintf(stderr, "BANANA-BOTTOM: %d x %d, avg %.2f ms per update, of which drawing %.2f ms, pbo %d, still %d (%llu updates, %llu skipped), %d Hz max\n", sw, sh, sumUs / 100000.0, sumDrawUs / 100000.0, pboOk, SecondScreenStill, (unsigned long long)frames, (unsigned long long)skipped, bhz);
+			fflush(stderr); sumUs = 0; sumDrawUs = 0;
