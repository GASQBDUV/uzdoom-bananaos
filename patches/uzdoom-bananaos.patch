+
+	GLint previousFramebuffer = 0;
+	GLint previousViewport[4] = { 0, 0, 0, 0 };
+	GLint previousScissor[4] = { 0, 0, 0, 0 };
+	GLfloat previousClearColor[4] = { 0.f, 0.f, 0.f, 0.f };
