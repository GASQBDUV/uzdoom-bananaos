 {
-	return false;
+	// bananaOS: draw the 2D layer (status bar, automap) into an off-screen target the size of the lower panel,
+	// read it back and put it on the panel through DRM.
+	if (GLRenderer == nullptr || drawer == nullptr || width <= 0 || height <= 0 || SecondScreenNativeWindow == nullptr ||
+		SecondScreenSurfaceWidth <= 0 || SecondScreenSurfaceHeight <= 0)
+	{
+		return false;
