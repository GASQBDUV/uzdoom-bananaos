 #include "gles_system.h"
 #include "v_video.h"
 #include "m_png.h"
@@ -670,13 +673,214 @@ bool OpenGLFrameBuffer::Render2DToMainScreen(F2DDrawer* drawer, int width, int h
 	return true;
 }
 #else
+extern "C" void banana_bottom_present(const uint8_t* rgba, int w, int h);
+extern "C" int banana_bottom_export(uint32_t* pitch);
+#include <SDL.h>
+
+// Zero-copy lower screen: the panel's buffer is imported into GL as a dma-buf texture and the picture is blitted
+// (upside down, GL's origin is at the bottom) straight into it, so there is no read-back to wait for.
+static int BananaZeroCopySetup(GLuint& fbo, GLuint& tex, int w, int h)
+{
+	typedef void* (*PFN_getdisplay)(void);
+	typedef void* (*PFN_createimage)(void*, void*, unsigned, void*, const int*);
+	typedef void (*PFN_target)(unsigned, void*);
+	auto getDisplay = (PFN_getdisplay)SDL_GL_GetProcAddress("eglGetCurrentDisplay");
+	auto createImage = (PFN_createimage)SDL_GL_GetProcAddress("eglCreateImageKHR");
+	auto imageTarget = (PFN_target)SDL_GL_GetProcAddress("glEGLImageTargetTexture2DOES");
+	if (!getDisplay || !createImage || !imageTarget) { fprintf(stderr, "BANANA-BOTTOM: zero-copy: EGL image functions missing\n"); return 0; }
+	uint32_t pitch = 0;
+	int prime = banana_bottom_export(&pitch);
+	if (prime < 0) return 0;
+	const int attrs[] = { 0x3057 /*EGL_WIDTH*/, w, 0x3056 /*EGL_HEIGHT*/, h, 0x3271 /*FOURCC*/, 0x34324258 /*XBGR8888*/,
+		0x3272 /*FD*/, prime, 0x3273 /*OFFSET*/, 0, 0x3274 /*PITCH*/, (int)pitch, 0x3038 /*EGL_NONE*/ };
+	void* image = createImage(getDisplay(), nullptr, 0x3270 /*EGL_LINUX_DMA_BUF_EXT*/, nullptr, attrs);
+	if (!image) { fprintf(stderr, "BANANA-BOTTOM: zero-copy: eglCreateImage failed\n"); return 0; }
+	glGenTextures(1, &tex);
+	glBindTexture(GL_TEXTURE_2D, tex);
+	imageTarget(GL_TEXTURE_2D, image);
+	glGenFramebuffers(1, &fbo);
+	glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+	glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, tex, 0);
+	GLenum st = glCheckFramebufferStatus(GL_FRAMEBUFFER);
+	if (st != GL_FRAMEBUFFER_COMPLETE) { fprintf(stderr, "BANANA-BOTTOM: zero-copy: framebuffer incomplete (0x%x)\n", st); return 0; }
+	fprintf(stderr, "BANANA-BOTTOM: zero-copy on (%dx%d, dma-buf)\n", w, h);
+	return 1;
+}
+
 void OpenGLFrameBuffer::SetSecondScreenNativeWindow(void* nativeWindow, int width, int height)
 {
+	SecondScreenNativeWindow = nativeWindow;
+	SecondScreenSurfaceWidth = width > 0 ? width : 0;
+	SecondScreenSurfaceHeight = height > 0 ? height : 0;
 }
 
